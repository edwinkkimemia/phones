# Database — replace with your Postgres URL (Neon / Supabase / RDS)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/phonelaptops?schema=public"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="https://phonelaptops.co.ke"

# Admin login (used by prisma seed to create the admin user)
ADMIN_EMAIL="admin@phonelaptops.co.ke"
ADMIN_PASSWORD="change-this-password"

# M-Pesa Daraja (Safaricom) — sandbox by default
MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="http://localhost:3000/api/payments/mpesa/callback"

# AI assistant (optional — built-in engine is used when unset)
OPENAI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Image uploads: connect a Vercel Blob store (auto-adds this) for production;
# without it, uploads fall back to local public/uploads/ (self-hosted only).
BLOB_READ_WRITE_TOKEN=""

# Store config
NEXT_PUBLIC_WHATSAPP_NUMBER="254715135141"
NEXT_PUBLIC_STORE_PHONE="+254 715 135 141"
NEXT_PUBLIC_STORE_EMAIL="support@phonelaptops.co.ke"
NEXT_PUBLIC_SITE_URL="https://phonelaptops.co.ke"
